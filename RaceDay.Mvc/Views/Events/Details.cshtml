@model EventDetailsViewModel

@{
    ViewData["Title"] = "Event Details";
}

<div class="card race-card p-4 mb-4">
    <span class="badge bg-primary align-self-start mb-2">
        @Model.Event.EventType
    </span>

    <h1>@Model.Event.EventName</h1>

    <p class="text-muted">@Model.Event.Description</p>

    <div class="row mt-3">
        <div class="col-md-4">
            <strong>Date</strong>
            <p>@Model.Event.EventDate.ToString("dd MMMM yyyy")</p>
        </div>

        <div class="col-md-4">
            <strong>Location</strong>
            <p>@Model.Event.Location</p>
        </div>

        <div class="col-md-4">
            <strong>Distance</strong>
            <p>@Model.Event.Distance km</p>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Event.FileUrl))
{
    var extension = System.IO.Path.GetExtension(
        new Uri(Model.Event.FileUrl).AbsolutePath
    ).ToLowerInvariant();

    <div class="card race-card p-4 mb-4">
        <h4>Event Poster / Document</h4>

        @if (new[] { ".jpg", ".jpeg", ".png", ".gif", ".webp" }
            .Contains(extension))
        {
            <img src="@Model.Event.FileUrl"
                 alt="Event poster"
                 class="img-fluid rounded mt-2"
                 style="max-width: 500px;" />
        }
        else if (extension == ".pdf")
        {
            <a href="@Model.Event.FileUrl"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-outline-primary mt-2">
                View / Download Event Document
            </a>
        }
    </div>
}

<h3 class="mb-3">Available Categories</h3>

@if (!Model.Categories.Any())
{
    <div class="alert alert-info">
        No categories have been added to this event yet.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var category in Model.Categories)
        {
            <div class="col-md-6">
                <div class="card race-card p-3">
                    <h5>@category.CategoryName</h5>

                    <p>Distance: @category.Distance km</p>
                    <p>Entry Fee: R @category.EntryFee</p>

                    @if (Context.Session.GetString("Role") == "Participant")
                    {
                        <form asp-controller="Participant"
                              asp-action="EnterEvent"
                              method="post">

                            <input type="hidden" name="eventId"
                                   value="@Model.Event.EventID" />

                            <input type="hidden" name="categoryId"
                                   value="@category.CategoryID" />

                            <button type="submit" class="btn btn-primary w-100">
                                Enter This Category
                            </button>
                        </form>
                    }
                    else if (Context.Session.GetString("Role") == null)
                    {
                        <a asp-controller="Auth" asp-action="Login"
                           class="btn btn-outline-primary w-100">
                            Login to Enter
                        </a>
                    }
                </div>
            </div>
        }
    </div>
}
