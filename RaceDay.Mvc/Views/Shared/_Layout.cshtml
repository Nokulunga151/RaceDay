<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Mvc.styles.css" asp-append-version="true" />
</head>

<body>
    @{
        var role = Context.Session.GetString("Role");
        var loggedIn = !string.IsNullOrEmpty(role);
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Events" asp-action="Index">
                    RaceDay
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceDayNavbar"
                        aria-controls="raceDayNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="raceDayNavbar">
                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">
                                Discover Events
                            </a>
                        </li>

                        @if (role == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="Index">
                                    Organiser Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Organiser" asp-action="CreateEvent">
                                    Create Event
                                </a>
                            </li>
                        }

                        @if (role == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="Index">
                                    Participant Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyEvents">
                                    My Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="MyResults">
                                    My Results
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Participant" asp-action="Profile">
                                    My Profile
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        @if (!loggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-primary ms-lg-2"
                                   asp-controller="Auth" asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="nav-link text-light">
                                    @role
                                </span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Auth" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm mt-1">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top text-muted py-3 mt-4">
        <div class="container text-center">
            &copy; 2026 RaceDay | All rights reserved.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>